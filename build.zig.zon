.{
    .name = .avrio_zig,
    .version = "0.1.0",
    .fingerprint = 0x25a1b035f3821321, // Changing this has security and trust implications.
    .minimum_zig_version = "0.15.2",
    .dependencies = .{
        .atmega328p = .{
            .path = "src/libzig/atmega328p/iop",
        },
        .delay = .{
            .path = "src/libzig/delay",
        },
        .uart_atmega328p = .{
            .path = "src/libzig/atmega328p/uart",
        },
        .xprintf= .{
            .path = "src/libzig/xprintf",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "LICENSE",
        "README.md",
    },
}
